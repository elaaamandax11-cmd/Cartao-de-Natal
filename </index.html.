 <!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Uma surpresa de Natal 🎄</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  overflow: hidden;
  font-family: Georgia, serif;
  color: #fff8e8;
  background:
    radial-gradient(ellipse at top, #17613e, transparent 65%),
    linear-gradient(145deg, #031c13, #0a3c27, #03180f);
  display: grid;
  place-items: center;
  padding: 20px;
}

.card {
  position: relative;
  z-index: 2;
  width: min(100%, 560px);
  padding: 35px 22px;
  text-align: center;
  border: 1px solid #e9c96d;
  border-radius: 25px;
  background: #062b20df;
  box-shadow: 0 0 35px #d4aa4250;
  animation: surgir 1.2s ease both;
}

h1 {
  color: #ffe8a1;
  font-size: clamp(36px, 9vw, 54px);
  text-shadow: 0 0 16px #ffd45b90;
  margin: 8px 0;
}

.subtitulo {
  font-size: 18px;
  line-height: 1.6;
}

button {
  border: 1px solid #ffe7a1;
  border-radius: 40px;
  background: linear-gradient(135deg, #d71f36, #941327);
  color: white;
  font: bold 16px Arial, sans-serif;
  padding: 16px 24px;
  cursor: pointer;
  box-shadow: 0 0 22px #ffcc5870;
  transition: transform .25s, box-shadow .25s;
}

button:hover {
  transform: scale(1.05);
  box-shadow: 0 0 30px #ffe18c;
}

button:focus-visible {
  outline: 3px solid white;
  outline-offset: 4px;
}

.message {
  display: none;
  margin-top: 25px;
  font-size: clamp(21px, 5vw, 29px);
  line-height: 1.7;
  color: #fff1b9;
  text-shadow: 0 0 8px #ffe28a, 0 0 22px #f2bd43;
}

.message.show {
  display: block;
  animation: revelar 1.5s ease both;
}

.heart {
  font-size: 28px;
  margin-top: 12px;
}

/* Arvorezinha no canto */
.tree {
  position: fixed;
  right: 12px;
  bottom: 10px;
  width: 105px;
  height: 175px;
  z-index: 1;
  filter: drop-shadow(0 0 9px #ffe77a80);
}

.star {
  color: #fff3a3;
  font-size: 24px;
  position: absolute;
  left: 40px;
  top: 0;
  opacity: 0;
  animation: montar .6s 1s forwards, piscar 1.5s 2s infinite;
}

.layer {
  position: absolute;
  width: 0;
  height: 0;
  border-left: solid transparent;
  border-right: solid transparent;
  border-bottom: solid #19834e;
  opacity: 0;
  filter: drop-shadow(0 0 6px #4aff9c80);
  animation: montar .7s forwards;
}

.l1 {
  top: 27px; left: 31px;
  border-left-width: 22px;
  border-right-width: 22px;
  border-bottom-width: 42px;
  animation-delay: 1.4s;
}
.l2 {
  top: 48px; left: 23px;
  border-left-width: 30px;
  border-right-width: 30px;
  border-bottom-width: 48px;
  animation-delay: 1.9s;
}
.l3 {
  top: 73px; left: 13px;
  border-left-width: 40px;
  border-right-width: 40px;
  border-bottom-width: 53px;
  animation-delay: 2.4s;
}

.trunk {
  position: absolute;
  top: 122px;
  left: 45px;
  width: 15px;
  height: 28px;
  background: #986039;
  opacity: 0;
  animation: montar .5s 2.9s forwards;
}

.light {
  position: absolute;
  z-index: 2;
  font-size: 13px;
  opacity: 0;
  animation: montar .4s forwards, piscar 1.3s 3.5s infinite;
}
.a { top: 49px; left: 44px; animation-delay: 3.1s, 3.5s; }
.b { top: 75px; left: 33px; animation-delay: 3.3s, 3.7s; }
.c { top: 91px; left: 59px; animation-delay: 3.5s, 3.9s; }
.d { top: 105px; left: 43px; animation-delay: 3.7s, 4.1s; }

.snow {
  position: fixed;
  top: -30px;
  z-index: 0;
  pointer-events: none;
  animation: cair linear infinite;
}

@keyframes cair {
  to { transform: translateY(110vh) rotate(300deg); }
}

@keyframes montar {
  from { opacity: 0; transform: translateY(12px) scale(.65); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes piscar {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.9) drop-shadow(0 0 7px #fff3a0); }
}

@keyframes surgir {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes revelar {
  from { opacity: 0; transform: scale(.85); filter: blur(8px); }
  to { opacity: 1; transform: scale(1); filter: blur(0); }
}

@media (max-width: 480px) {
  .tree {
    width: 78px;
    transform: scale(.8);
    transform-origin: bottom right;
    right: 4px;
    bottom: 2px;
  }
  .card { padding: 30px 18px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
  }
}
</style>
</head>

<body>

<main class="card">
  <div style="font-size:30px">✨ ❄️ ✨</div>
  <h1>Feliz Natal!</h1>

  <p class="subtitulo">
    Um pequeno gesto, uma mensagem
    e um desejo cheio de carinho. ❤️
  </p>

  <p>
    <button id="abrir" type="button">
      🎁 Abrir minha mensagem
    </button>
  </p>

  <div id="mensagem" class="message" aria-live="polite">
    Que vc tenha um natal feliz ao lado
    de quem ama, os momentos somos nós
    que fizemos, Deus te abençoe!
    <div class="heart">❤️ ✨ 🎄</div>
  </div>
</main>

<!-- Árvore montada em etapas -->
<div class="tree" aria-label="Árvore de Natal iluminada">
  <div class="star">★</div>
  <div class="layer l1"></div>
  <div class="layer l2"></div>
  <div class="layer l3"></div>
  <div class="trunk"></div>
  <div class="light a">✨</div>
  <div class="light b">🔴</div>
  <div class="light c">✨</div>
  <div class="light d">🟡</div>
</div>

<script>
const botao = document.getElementById("abrir");
const mensagem = document.getElementById("mensagem");

botao.addEventListener("click", () => {
  mensagem.classList.add("show");
  botao.textContent = "❤️ Feliz Natal!";
  botao.disabled = true;
  botao.style.opacity = ".8";
});

// Neve suave
const simbolos = ["❄", "✦", "✧"];

for (let i = 0; i < 25; i++) {
  const floco = document.createElement("span");
  floco.className = "snow";
  floco.textContent =
    simbolos[Math.floor(Math.random() * simbolos.length)];
  floco.style.left = Math.random() * 100 + "vw";
  floco.style.fontSize = (10 + Math.random() * 17) + "px";
  floco.style.color = "#fff4c9";
  floco.style.opacity = .3 + Math.random() * .6;
  floco.style.animationDuration = (7 + Math.random() * 10) + "s";
  floco.style.animationDelay = (-Math.random() * 15) + "s";
  document.body.appendChild(floco);
}
</script>

</body>
</html>
